{
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!assets|api|static|favicon\\.svg|icons\\.svg|vite\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
