# ===============================================
# TESTLY AI - ENVIRONMENT VARIABLES
# ===============================================

# [1] Google Gemini AI API Key
# Required for AI-powered Test Plan Generation, Code Generation, and Bug Analysis
# Get one for free at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# [2] Frontend API Base URL
# Optional:
# - When deploying Frontend + Backend together on Vercel: leave blank or set to /api
# - When deploying Backend separately (e.g., Render, Railway): set to your backend URL (e.g. https://your-backend.onrender.com/api)
VITE_API_BASE=/api

# [3] Python Version (Optional - for Vercel Python Runtime)
PYTHON_VERSION=3.10
